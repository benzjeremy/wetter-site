<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_bg" android:id="@+id/widget_root">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="—" android:textSize="17sp" android:textColor="@color/text_primary" android:singleLine="true" android:ellipsize="end" android:layout_weight="1" android:fontFamily="serif" android:id="@+id/widget_location"/>
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textColor="@color/text_secondary" android:id="@+id/widget_clock"/>
    <ImageButton android:layout_width="38dp" android:layout_height="38dp" android:src="@android:drawable/ic_popup_sync" android:background="@drawable/btn_bg" android:tint="@color/text_primary" android:contentDescription="@string/refresh" android:id="@+id/widget_refresh_btn"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="32sp" android:textColor="@color/text_primary" android:singleLine="true" android:ellipsize="end" android:id="@+id/widget_temp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="21sp" android:textColor="@color/text_primary" android:singleLine="true" android:ellipsize="end" android:paddingStart="4dp" android:id="@+id/widget_icon"/>
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="—" android:textSize="14sp" android:textColor="@color/text_primary" android:singleLine="true" android:ellipsize="end" android:layout_weight="1" android:paddingStart="8dp" android:id="@+id/widget_desc"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="—" android:textSize="12sp" android:textColor="@color/text_primary" android:singleLine="true" android:ellipsize="end" android:layout_weight="1" android:id="@+id/widget_high_low"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="12sp" android:textColor="@color/text_primary" android:singleLine="true" android:ellipsize="end" android:id="@+id/widget_updated"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="—" android:textSize="12sp" android:textColor="@color/text_primary" android:singleLine="true" android:ellipsize="end" android:layout_weight="1" android:id="@+id/widget_rain"/>
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="—" android:textSize="12sp" android:textColor="@color/text_primary" android:singleLine="true" android:ellipsize="end" android:layout_weight="1" android:id="@+id/widget_wind"/>
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="—" android:textSize="12sp" android:textColor="@color/text_primary" android:singleLine="true" android:ellipsize="end" android:layout_weight="1" android:id="@+id/widget_pv"/>
  </LinearLayout>
</LinearLayout>
